# ==============================================================================
# SYNAPSE CLINICAL — MULTI-MODEL AGENTIC CRAG CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database Connection (PostgreSQL with pgvector or SQLite for local dev)
DATABASE_URL=postgresql://synapse:clinical_secure_pass@localhost:5432/synapse_db
# For SQLite offline local development:
# DATABASE_URL=sqlite:///./synapse_ehr.db

# ------------------------------------------------------------------------------
# MULTI-MODEL LLM PROVIDER API KEYS
# (Synapse Clinical uses LiteLLM to dynamically route across multiple providers)
# ------------------------------------------------------------------------------

# OpenRouter (Supports 100% Free Tier Models: Nemotron, Gemma, Qwen, etc.)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_CHAT_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,openrouter/free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# OpenAI (Synthesis & Verification models)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Google Gemini (High-throughput Flash & reasoning models)
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic (Clinical synthesis models)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Local Ollama Host (Optional local privacy-preserving inference)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# TASK-SPECIFIC MODEL ORCHESTRATION ASSIGNMENTS
# ------------------------------------------------------------------------------
FAST_LLM_MODEL=gpt-4o-mini
SYNTHESIS_LLM_MODEL=gpt-4o
EVALUATOR_LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Provider Fallback Settings
ENABLE_PROVIDER_FALLBACK=true
CIRCUIT_BREAKER_MAX_FAILURES=3
CIRCUIT_BREAKER_RESET_SECONDS=60.0

# ------------------------------------------------------------------------------
# RETRIEVAL & RERANKER PARAMETERS
# ------------------------------------------------------------------------------
RETRIEVAL_DENSE_TOP_K=25
RETRIEVAL_BM25_TOP_K=25
RETRIEVAL_RERANK_TOP_N=6
CRAG_RELEVANCE_THRESHOLD=0.65
MAX_CRAG_REFORMULATION_RETRIES=2

# ------------------------------------------------------------------------------
# REGULATORY & SAFETY
# ------------------------------------------------------------------------------
MOCK_MODE=false
REQUIRE_HITL_ON_FATAL_DDI=true
REQUIRE_HITL_ON_CONTROLLED_SUBSTANCES=true
REQUIRE_HITL_ON_CHEMOTHERAPY=true

# Frontend public API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
